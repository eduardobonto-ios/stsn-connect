\[\\[data-side\\=left\\]\\[data-collapsible\\=offcanvas\\]_\\&\\]\\:-right-2 {\n    [data-side=left][data-collapsible=offcanvas] & {\n      right: calc(var(--spacing) * -2);\n    }\n  }\n  .\\[\\[data-side\\=left\\]\\[data-state\\=collapsed\\]_\\&\\]\\:cursor-e-resize {\n    [data-side=left][data-state=collapsed] & {\n      cursor: e-resize;\n    }\n  }\n  .\\[\\[data-side\\=right\\]_\\&\\]\\:cursor-e-resize {\n    [data-side=right] & {\n      cursor: e-resize;\n    }\n  }\n  .\\[\\[data-side\\=right\\]\\[data-collapsible\\=offcanvas\\]_\\&\\]\\:-left-2 {\n    [data-side=right][data-collapsible=offcanvas] & {\n      left: calc(var(--spacing) * -2);\n    }\n  }\n  .\\[\\[data-side\\=right\\]\\[data-state\\=collapsed\\]_\\&\\]\\:cursor-w-resize {\n    [data-side=right][data-state=collapsed] & {\n      cursor: w-resize;\n    }\n  }\n  .\\[\\[data-slot\\=card-content\\]_\\&\\]\\:bg-transparent {\n    [data-slot=card-content] & {\n      background-color: transparent;\n    }\n  }\n  .\\[\\[data-slot\\=popover-content\\]_\\&\\]\\:bg-transparent {\n    [data-slot=popover-content] & {\n      background-color: transparent;\n    }\n  }\n}\n:root {\n  --stsn-page-bg: #fffdf6;\n  --stsn-card-bg: #ffffff;\n  --stsn-card-border: #e6d9b8;\n  --stsn-card-radius: 0.75rem;\n  --stsn-card-shadow: 0 1px 3px rgba(7, 28, 52, 0.08), 0 12px 28px rgba(7, 28, 52, 0.06);\n  --stsn-control-radius: 0.875rem;\n  --stsn-control-shadow: 0 1px 2px rgba(16, 32, 51, 0.04);\n  --stsn-surface-shadow: 0 1px 2px rgba(16, 32, 51, 0.04),\n    0 12px 28px rgba(16, 32, 51, 0.08);\n  --stsn-muted-text: #64748b;\n  --stsn-heading-text: #102033;\n  --stsn-secondary-text: #36506d;\n  --stsn-focus-ring: rgba(231, 184, 47, 0.28);\n  --stsn-info-bg: #eff6ff;\n  --stsn-success-bg: #ecfdf5;\n  --stsn-warning-bg: #fffbeb;\n  --stsn-danger-bg: #fef2f2;\n  --stsn-purple-bg: #f5f3ff;\n  --erp-page-bg: #fffdf6;\n  --erp-surface: #ffffff;\n  --erp-surface-muted: #f8f2e4;\n  --erp-border: #e6d9b8;\n  --erp-text: #102033;\n  --erp-text-muted: #64748b;\n  --erp-brand: #0a2748;\n  --erp-accent: #e7b82f;\n  --status-draft-bg: #f4f4f5;\n  --status-draft-text: #52525b;\n  --status-draft-border: #d4d4d8;\n  --status-pending-bg: #fffbeb;\n  --status-pending-text: #92400e;\n  --status-pending-border: #fde68a;\n  --status-review-bg: #eff6ff;\n  --status-review-text: #1d4ed8;\n  --status-review-border: #bfdbfe;\n  --status-approved-bg: #ecfdf5;\n  --status-approved-text: #047857;\n  --status-approved-border: #a7f3d0;\n  --status-rejected-bg: #fef2f2;\n  --status-rejected-text: #b91c1c;\n  --status-rejected-border: #fecaca;\n  --status-cancelled-bg: #f5f5f4;\n  --status-cancelled-text: #57534e;\n  --status-cancelled-border: #d6d3d1;\n  --status-academic-active-bg: #ecfdf5;\n  --status-academic-active-text: #047857;\n  --status-academic-active-border: #a7f3d0;\n  --status-academic-enrolled-bg: #eef2ff;\n  --status-academic-enrolled-text: #4338ca;\n  --status-academic-enrolled-border: #c7d2fe;\n  --status-academic-graduated-bg: #f5f3ff;\n  --status-academic-graduated-text: #6d28d9;\n  --status-academic-graduated-border: #ddd6fe;\n  --status-academic-dropped-bg: #fef2f2;\n  --status-academic-dropped-text: #b91c1c;\n  --status-academic-dropped-border: #fecaca;\n  --status-academic-leave-bg: #fff7ed;\n  --status-academic-leave-text: #c2410c;\n  --status-academic-leave-border: #fed7aa;\n  --status-academic-suspended-bg: #fdf2f8;\n  --status-academic-suspended-text: #be185d;\n  --status-academic-suspended-border: #fbcfe8;\n  --status-finance-credit-bg: #ecfdf5;\n  --status-finance-credit-text: #047857;\n  --status-finance-credit-border: #a7f3d0;\n  --status-finance-debit-bg: #eff6ff;\n  --status-finance-debit-text: #1d4ed8;\n  --status-finance-debit-border: #bfdbfe;\n  --status-finance-balance-bg: #f8fafc;\n  --status-finance-balance-text: #334155;\n  --status-finance-balance-border: #cbd5e1;\n  --status-finance-overdue-bg: #fef2f2;\n  --status-finance-overdue-text: #b91c1c;\n  --status-finance-overdue-border: #fecaca;\n  --status-finance-paid-bg: #ecfdf5;\n  --status-finance-paid-text: #047857;\n  --status-finance-paid-border: #a7f3d0;\n  --status-finance-partial-bg: #fffbeb;\n  --status-finance-partial-text: #92400e;\n  --status-finance-partial-border: #fde68a;\n  --status-finance-waived-bg: #f5f3ff;\n  --status-finance-waived-text: #6d28d9;\n  --status-finance-waived-border: #ddd6fe;\n  --status-neutral-bg: #f5f5f4;\n  --status-neutral-text: #57534e;\n  --status-neutral-border: #d6d3d1;\n  --stsn-banner-bg: linear-gradient(135deg, #071c34 0%, #0a2748 48%, #123a63 100%);\n  --stsn-banner-text: #fffdf5;\n  --stsn-banner-border: rgba(231, 184, 47, 0.28);\n  --stsn-banner-eyebrow: rgba(242, 201, 76, 0.9);\n  --stsn-banner-subtitle: rgba(255, 253, 246, 0.74);\n  --stsn-shell-bg: radial-gradient(circle at top, rgba(255, 255, 255, 0.78), transparent 38%),\n    linear-gradient(180deg, #fffdf6 0%, #f8f2e4 100%);\n  --stsn-shell-content-max: 1680px;\n  --stsn-shell-edge-padding: clamp(1rem, 2vw, 2rem);\n  --stsn-shell-section-gap: clamp(1rem, 2vw, 1.5rem);\n  --stsn-sidebar-border: rgba(255, 255, 255, 0.08);\n  --stsn-sidebar-shadow: 18px 0 48px rgba(7, 28, 52, 0.24);\n  --stsn-shell-header-bg: rgba(255, 253, 246, 0.88);\n  --stsn-shell-header-border: rgba(231, 184, 47, 0.18);\n  --stsn-shell-breadcrumb-bg: rgba(255, 255, 255, 0.7);\n  --stsn-shell-main-bg: radial-gradient(circle at top right, rgba(255, 255, 255, 0.94), transparent 22%),\n    linear-gradient(180deg, #fffdf6 0%, #f8f2e4 100%);\n}\n.app-page-bg {\n  background: var(--stsn-page-bg);\n}\n.app-card {\n  background: var(--stsn-card-bg);\n  border: 1px solid var(--stsn-card-border);\n  border-radius: var(--stsn-card-radius);\n  box-shadow: var(--stsn-surface-shadow);\n}\n.app-detail-hero {\n  background: linear-gradient(135deg, #071c34 0%, #0a2748 52%, #123a63 100%);\n}\n.app-detail-hero-college {\n  background: linear-gradient(135deg, #071c34 0%, #0d3156 52%, #184a79 100%);\n}\n.app-detail-hero-badge {\n  background: rgba(255, 255, 255, 0.1);\n  border: 1px solid rgba(255, 255, 255, 0.16);\n  color: rgba(255, 253, 246, 0.88);\n}\n.app-local-panel-tabs {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 253, 246, 0.94));\n  border-bottom: 1px solid rgba(230, 217, 184, 0.8);\n}\n.app-local-toolbar {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 253, 246, 0.95));\n}\n.app-local-table-head th {\n  background: linear-gradient(180deg, #f8f2e4 0%, #f3e6c6 100%);\n  color: var(--erp-text-muted);\n  font-family: \"JetBrains Mono\", monospace;\n  font-size: 0.625rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  border-bottom: 1px solid var(--erp-border);\n}\n.app-shell {\n  background: var(--stsn-shell-bg);\n}\n.app-shell-sidebar {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 18%), linear-gradient(180deg, #071c34 0%, #0a2748 25%, #123a63 65%, #184a79 100%);\n  border-right: 1px solid var(--stsn-sidebar-border);\n  box-shadow: var(--stsn-sidebar-shadow);\n}\n.app-shell-sidebar-header {\n  background: linear-gradient( 180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100% );\n}\n.app-shell-school-card {\n  background: linear-gradient( 180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.04) 100% );\n}\n.app-shell-school-card-active {\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);\n}\n.app-shell-nav {\n  scrollbar-color: rgba(231, 184, 47, 0.7) rgba(255, 255, 255, 0.04);\n}\n.app-shell-nav-item, .app-shell-nav-child {\n  position: relative;\n  border: 1px solid transparent;\n  transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease, color 0.18s ease;\n}\n.app-shell-nav-item:hover, .app-shell-nav-child:hover {\n  transform: translateX(1px);\n}\n.app-shell-nav-item:not(.app-shell-nav-item-active):hover {\n  background: rgba(255, 255, 255, 0.08);\n  border-color: rgba(255, 255, 255, 0.08);\n}\n.app-shell-nav-child:not(.app-shell-nav-child-active):hover {\n  background: rgba(255, 255, 255, 0.06);\n  border-color: rgba(255, 255, 255, 0.06);\n}\n.app-shell-nav-nested {\n  border-left-style: solid;\n  border-left-color: rgba(255, 255, 255, 0.1);\n}\n.sidebar-item-active {\n  background: linear-gradient( 135deg, rgba(231, 184, 47, 0.24) 0%, rgba(18, 58, 99, 0.82) 100% );\n  border-left: 3px solid #e7b82f;\n}\n.app-shell-nav-item-active, .app-shell-nav-child-active {\n  border-color: rgba(197, 160, 89, 0.18);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 10px 20px rgba(7, 28, 52, 0.18);\n}\n.app-shell-main-column {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.4), transparent 20%);\n}\n.app-shell-topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 1rem var(--stsn-shell-edge-padding);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.4), transparent 100%), var(--stsn-shell-header-bg);\n  border-bottom-color: var(--stsn-shell-header-border);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n}\n.app-shell-breadcrumb-inner, .app-shell-main-inner {\n  width: 100%;\n  max-width: var(--stsn-shell-content-max);\n}\n.app-shell-topbar-inner {\n  display: flex;\n  align-items: center;\n  flex: 1 1 auto;\n  min-width: 0;\n}\n.app-shell-topbar-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  flex: 0 0 auto;\n  gap: 0.75rem;\n}\n.app-shell-utility-button, .app-shell-utility-panel {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), #fff8ea 100%);\n  border: 1px solid rgba(230, 217, 184, 0.9);\n  box-shadow: 0 8px 20px rgba(7, 28, 52, 0.08);\n}\n.app-shell-utility-button:hover {\n  border-color: rgba(231, 184, 47, 0.42);\n  background: linear-gradient(180deg, #ffffff 0%, #fff8e4 100%);\n}\n.app-shell-breadcrumb {\n  background: var(--stsn-shell-breadcrumb-bg);\n  border-bottom: 1px solid rgba(230, 