1) 100% );\n  border: 1px solid rgba(59, 130, 246, 0.3);\n  color: #1d4ed8;\n}\n.stepper-active {\n  background: linear-gradient(135deg, #0a2748 0%, #123a63 100%);\n  color: #fffdf5;\n  border: 2px solid #e7b82f;\n}\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: var(--color-stsn-cream);\n}\n::-webkit-scrollbar-thumb {\n  background: linear-gradient(180deg, #e7b82f 0%, #d6a21e 100%);\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: linear-gradient(180deg, #f2c94c 0%, #e7b82f 100%);\n}\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n@keyframes slideInLeft {\n  from {\n    opacity: 0;\n    transform: translateX(-16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n@keyframes shimmer {\n  0% {\n    background-position: -200% center;\n  }\n  100% {\n    background-position: 200% center;\n  }\n}\n.animate-fade-in {\n  animation: fadeIn 0.4s ease-out forwards;\n}\n.animate-slide-in {\n  animation: slideInLeft 0.35s ease-out forwards;\n}\n.smooth-hover {\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.smooth-hover:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 16px rgba(7, 28, 52, 0.12);\n}\n.glass-card {\n  background: rgba(255, 253, 246, 0.78);\n  backdrop-filter: blur(12px);\n  border: 1px solid rgba(231, 184, 47, 0.2);\n  box-shadow: 0 4px 24px rgba(7, 28, 52, 0.08);\n}\n.stsn-filter-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.375rem 0.75rem;\n  border-radius: 0.5rem;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 0.75rem;\n  font-weight: 600;\n  border: 1px solid #e6d9b8;\n  background: #ffffff;\n  color: #36506d;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  white-space: nowrap;\n}\n.stsn-filter-chip:hover:not(.active):not(:disabled) {\n  border-color: rgba(10, 39, 72, 0.24);\n  background: rgba(255, 253, 246, 0.82);\n}\n.stsn-filter-chip.active, .stsn-filter-chip[aria-pressed=\"true\"] {\n  background: #0a2748;\n  color: #fffdf5;\n  border-color: #0a2748;\n  box-shadow: 0 1px 4px rgba(7, 28, 52, 0.2);\n}\n.stsn-filter-chip-college.active, .stsn-filter-chip-college[aria-pressed=\"true\"] {\n  background: #2563eb;\n  color: #ffffff;\n  border-color: #2563eb;\n}\n.stsn-filter-chip:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n.stsn-filter-chip-pill {\n  border-radius: 9999px;\n}\n.stsn-filter-chip-sm {\n  font-size: 0.625rem;\n  padding: 0.25rem 0.625rem;\n}\n.stsn-filter-chip-count {\n  padding: 0.125rem 0.375rem;\n  border-radius: 9999px;\n  font-size: 0.5625rem;\n  font-weight: 700;\n  line-height: 1;\n  background: rgba(0, 0, 0, 0.08);\n}\n.stsn-filter-chip.active .stsn-filter-chip-count {\n  background: rgba(255, 255, 255, 0.2);\n}\n.stsn-filter-bar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n}\n.stsn-filter-chip-group {\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n  flex-wrap: wrap;\n}\n.stsn-plain-table {\n  width: 100%;\n  border-collapse: separate;\n  border-spacing: 0;\n  font-size: 0.75rem;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  border: 1px solid #e6d9b8;\n  border-radius: 0.75rem;\n  overflow: hidden;\n}\n.stsn-plain-table thead th {\n  background: linear-gradient(180deg, #f8f2e4 0%, #f3e6c6 100%);\n  color: #64748b;\n  font-family: \"JetBrains Mono\", monospace;\n  font-weight: 700;\n  text-transform: uppercase;\n  font-size: 0.625rem;\n  letter-spacing: 0.08em;\n  padding: 0.55rem 1rem;\n  border-bottom: 1px solid #e6d9b8;\n  white-space: nowrap;\n  text-align: left;\n  vertical-align: middle;\n}\n.stsn-plain-table thead th:first-child {\n  border-top-left-radius: 0.75rem;\n}\n.stsn-plain-table thead th:last-child {\n  border-top-right-radius: 0.75rem;\n  text-align: right;\n}\n.stsn-plain-table tbody td {\n  padding: 0.625rem 1rem;\n  border-bottom: 1px solid #f0e7d1;\n  color: #102033;\n  vertical-align: middle;\n}\n.stsn-plain-table tbody tr:last-child td {\n  border-bottom: none;\n}\n.stsn-plain-table tbody tr:hover {\n  background: rgba(231, 184, 47, 0.06);\n}\n.stsn-plain-table tbody tr:last-child td:first-child {\n  border-bottom-left-radius: 0.75rem;\n}\n.stsn-plain-table tbody tr:last-child td:last-child {\n  border-bottom-right-radius: 0.75rem;\n}\n.stsn-plain-table td:last-child {\n  text-align: right;\n}\n.payroll-workflow-table-card {\n  position: relative;\n}\n.payroll-workflow-table {\n  min-height: 22rem;\n  contain: layout paint;\n}\n.payroll-money-cell {\n  min-width: 7.5rem;\n  white-space: nowrap;\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n.billing-table-card {\n  padding: 1rem;\n}\n.billing-table-wrapper {\n  margin-top: 0.75rem;\n}\n@media (max-width: 640px) {\n  .billing-table-card {\n    padding: 0.75rem;\n  }\n}\n@media print {\n  body * {\n    visibility: hidden;\n  }\n  .print-card {\n    visibility: visible !important;\n    position: absolute !important;\n    inset: 0 !important;\n    max-width: none !important;\n    width: 100% !important;\n    margin: 0 !important;\n    padding: 32px !important;\n    background: white !important;\n    border: none !important;\n    box-shadow: none !important;\n    border-radius: 0 !important;\n    z-index: 9999 !important;\n  }\n  .print-card * {\n    visibility: visible !important;\n  }\n  .no-print {\n    display: none !important;\n  }\n  .print-only {\n    display: block !important;\n  }\n}\n@property --tw-translate-x {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-translate-y {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-translate-z {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-scale-x {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-scale-y {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-sc