-header {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);\n}\n@media (max-width: 1024px) {\n  .app-shell-topbar {\n    padding-block: 0.875rem;\n  }\n  .app-shell-main-inner {\n    padding-top: 1rem;\n    padding-bottom: 1.25rem;\n  }\n}\n@media (max-width: 768px) {\n  .app-shell-topbar {\n    gap: 0.75rem;\n    padding-inline: 1rem;\n  }\n  .app-shell-topbar-actions {\n    gap: 0.5rem;\n  }\n  .app-shell-breadcrumb-inner {\n    padding: 0.625rem 1rem;\n  }\n  .app-shell-alert-slot {\n    padding-inline: 1rem;\n  }\n  .app-shell-main-inner {\n    padding-inline: 1rem;\n  }\n}\n.stsn-status-badge {\n  background: var(--status-neutral-bg);\n  color: var(--status-neutral-text);\n  border-color: var(--status-neutral-border);\n}\n.stsn-status-neutral {\n  background: var(--status-neutral-bg);\n  color: var(--status-neutral-text);\n  border-color: var(--status-neutral-border);\n}\n.stsn-status-workflow-draft {\n  background: var(--status-draft-bg);\n  color: var(--status-draft-text);\n  border-color: var(--status-draft-border);\n}\n.stsn-status-workflow-pending {\n  background: var(--status-pending-bg);\n  color: var(--status-pending-text);\n  border-color: var(--status-pending-border);\n}\n.stsn-status-workflow-review {\n  background: var(--status-review-bg);\n  color: var(--status-review-text);\n  border-color: var(--status-review-border);\n}\n.stsn-status-workflow-approved {\n  background: var(--status-approved-bg);\n  color: var(--status-approved-text);\n  border-color: var(--status-approved-border);\n}\n.stsn-status-workflow-rejected {\n  background: var(--status-rejected-bg);\n  color: var(--status-rejected-text);\n  border-color: var(--status-rejected-border);\n}\n.stsn-status-workflow-cancelled {\n  background: var(--status-cancelled-bg);\n  color: var(--status-cancelled-text);\n  border-color: var(--status-cancelled-border);\n}\n.stsn-status-academic-active {\n  background: var(--status-academic-active-bg);\n  color: var(--status-academic-active-text);\n  border-color: var(--status-academic-active-border);\n}\n.stsn-status-academic-enrolled {\n  background: var(--status-academic-enrolled-bg);\n  color: var(--status-academic-enrolled-text);\n  border-color: var(--status-academic-enrolled-border);\n}\n.stsn-status-academic-graduated {\n  background: var(--status-academic-graduated-bg);\n  color: var(--status-academic-graduated-text);\n  border-color: var(--status-academic-graduated-border);\n}\n.stsn-status-academic-dropped {\n  background: var(--status-academic-dropped-bg);\n  color: var(--status-academic-dropped-text);\n  border-color: var(--status-academic-dropped-border);\n}\n.stsn-status-academic-leave {\n  background: var(--status-academic-leave-bg);\n  color: var(--status-academic-leave-text);\n  border-color: var(--status-academic-leave-border);\n}\n.stsn-status-academic-suspended {\n  background: var(--status-academic-suspended-bg);\n  color: var(--status-academic-suspended-text);\n  border-color: var(--status-academic-suspended-border);\n}\n.stsn-status-finance-credit {\n  background: var(--status-finance-credit-bg);\n  color: var(--status-finance-credit-text);\n  border-color: var(--status-finance-credit-border);\n}\n.stsn-status-finance-debit {\n  background: var(--status-finance-debit-bg);\n  color: var(--status-finance-debit-text);\n  border-color: var(--status-finance-debit-border);\n}\n.stsn-status-finance-balance {\n  background: var(--status-finance-balance-bg);\n  color: var(--status-finance-balance-text);\n  border-color: var(--status-finance-balance-border);\n}\n.stsn-status-finance-overdue {\n  background: var(--status-finance-overdue-bg);\n  color: var(--status-finance-overdue-text);\n  border-color: var(--status-finance-overdue-border);\n}\n.stsn-status-finance-paid {\n  background: var(--status-finance-paid-bg);\n  color: var(--status-finance-paid-text);\n  border-color: var(--status-finance-paid-border);\n}\n.stsn-status-finance-partial {\n  background: var(--status-finance-partial-bg);\n  color: var(--status-finance-partial-text);\n  border-color: var(--status-finance-partial-border);\n}\n.stsn-status-finance-waived {\n  background: var(--status-finance-waived-bg);\n  color: var(--status-finance-waived-text);\n  border-color: var(--status-finance-waived-border);\n}\nbody, button, input, select, textarea, table {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n}\nh1, h2, h3, .page-title, .module-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700;\n}\n.brand-title, .system-title {\n  font-family: \"Space Grotesk\", \"Inter\", sans-serif;\n  font-weight: 700;\n}\n.stsn-page-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 1.125rem;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  color: var(--stsn-banner-text);\n  line-height: 1.2;\n}\n.stsn-page-eyebrow {\n  font-family: \"JetBrains Mono\", monospace;\n  font-size: 0.625rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  color: var(--stsn-banner-eyebrow);\n}\n.stsn-page-subtitle {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 0.75rem;\n  font-weight: 400;\n  color: var(--stsn-banner-subtitle);\n  line-height: 1.4;\n}\n.stsn-section-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 0.9375rem;\n  font-weight: 700;\n  letter-spacing: -0.01em;\n  color: var(--stsn-heading-text);\n  line-height: 1.3;\n}\n.stsn-form-label {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 0.6875rem;\n  font-weight: 600;\n  letter-spacing: 0.03em;\n  color: var(--erp-brand);\n  text-transform: uppercase;\n}\n.stsn-helper-text {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 0.6875rem;\n  font-weight: 400;\n  color: var(--stsn-muted-text);\n  line-height: 1.4;\n}\n.stsn-table-header {\n  font-family: \"JetBrains Mono\", monospace;\n  font-size: 0.625rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: #fffdf5;\n}\n.sidebar-gradient {\n  background: linear-gradient( 180deg, #071c34 0%, #0a2748 25%, #123a63 65%, #184a79 100% );\n}\n.sidebar-item-active {\n  background: linear-gradient( 135deg, rgba(231, 184, 47, 0.24) 0%, rgba(18, 58, 99, 0.76) 100% );\n  border-left: 3px solid #e7b82f;\n}\n.header-gradient {\n  background: linear-gradient(135deg, #ffffff 0%, #fffdf6 60%, #f8f2e4 100%);\n  border-bottom: 1px solid rgba(231, 184, 47, 0.15);\n}\n.btn-primary-gradient {\n  background: linear-gradient(135deg, #0a2748 0%, #123a63 55%, #184a79 100%);\n  box-shadow: 0 2px 8px rgba(7, 28, 52, 0.34);\n  transition: all 0.2s ease;\n}\n.btn-primary-gradient:hover {\n  background: linear-gradient(135deg, #123a63 0%, #184a79 50%, #215a8f 100%);\n  box-shadow: 0 4px 12px rgba(7, 28, 52, 0.42);\n  transform: translateY(-1px);\n}\n.btn-gold-gradient {\n  background: linear-gradient(135deg, #e7b82f 0%, #d6a21e 100%);\n  box-shadow: 0 2px 8px rgba(231, 184, 47, 0.34);\n}\n.btn-gold-gradient:hover {\n  background: linear-gradient(135deg, #f2c94c 0%, #e7b82f 100%);\n}\n.stsn-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700;\n  font-size: 0.875rem;\n  padding: 0.625rem 1.25rem;\n  border-radius: 0.75rem;\n  transition: all 0.15s ease;\n  cursor: pointer;\n  border: none;\n}\n.stsn-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n.stsn-btn-primary {\n  background: #e7b82f;\n  color: #071c34;\n  box-shadow: 0 4px 12px rgba(231, 184, 47, 0.32);\n}\n.stsn-btn-primary:hover:not(:disabled) {\n  background: #f2c94c;\n  box-shadow: 0 4px 16px rgba(231, 184, 47, 0.4);\n}\n.stsn-btn-secondary {\n  background: #fffdf6;\n  color: #36506d;\n  border: 1px solid #e6d9b8;\n}\n.stsn-btn-secondary:hover:not(:disabled) {\n  background: #f8f2e4;\n}\n.stsn-btn-destructive {\n  background: #dc2626;\n  color: #ffffff;\n  box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);\n}\n.stsn-btn-destructive:hover:not(:disabled) {\n  background: #b91c1c;\n}\n.stsn-btn-danger-outline {\n  background: #fef2f2;\n  color: #b91c1c;\n  border: 1px solid #fecaca;\n}\n.stsn-btn-danger-outline:hover:not(:disabled) {\n  background: #fee2e2;\n}\n.stsn-btn-sm {\n  font-size: 0.75rem;\n  padding: 0.5rem 1rem;\n  border-radius: 0.75rem;\n}\n.stsn-btn-xs {\n  font-size: 0.625rem;\n  padding: 0.375rem 0.75rem;\n  border-radius: 0.5rem;\n  font-weight: 700;\n}\n.card-hero-gradient {\n  background: linear-gradient( 135deg, #071c34 0%, #0a2748 42%, #123a63 80%, #184a79 100% );\n}\n.card-stat-gradient {\n  background: linear-gradient(135deg, #ffffff 0%, #fffdf6 100%);\n  border: 1px solid rgba(230, 217, 184, 0.88);\n}\n.card-gold-accent {\n  background: linear-gradient( 135deg, rgba(231, 184, 47, 0.1) 0%, rgba(255, 253, 246, 1) 50% );\n  border: 1px solid rgba(231, 184, 47, 0.24);\n}\n.widget-brown {\n  background: linear-gradient(135deg, #0a2748 0%, #123a63 100%);\n}\n.widget-gold {\n  background: linear-gradient(135deg, #e7b82f 0%, #d6a21e 100%);\n}\n.widget-cream {\n  background: linear-gradient(135deg, #fffdf6 0%, #f8f2e4 100%);\n}\n.section-header-gradient {\n  background: linear-gradient(135deg, #071c34 0%, #123a63 100%);\n  color: #fffdf5;\n}\n.section-header-light {\n  background: linear-gradient(135deg, #fffdf6 0%, #f8f2e4 100%);\n  border-bottom: 2px solid rgba(231, 184, 47, 0.3);\n}\n.module-page-banner {\n  background: linear-gradient(135deg, #071c34 0%, #0a2748 48%, #123a63 100%);\n}\n.module-page-banner-college {\n  background: linear-gradient(135deg, #071c34 0%, #0a2748 48%, #184a79 100%);\n}\n.module-page-banner-accent {\n  height: 2px;\n  background: linear-gradient( 90deg, rgba(231, 184, 47, 0) 0%, #e7b82f 50%, rgba(231, 184, 47, 0) 100% );\n}\n.module-page-banner-accent-college {\n  height: 2px;\n  background: linear-gradient( 90deg, rgba(96, 1