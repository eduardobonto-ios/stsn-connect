# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project credentials (anon key is safe to expose client-side).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ── Playwright E2E (Phase 3) ────────────────────────────────────────────────
# All optional — the suite falls back to the known dev/demo accounts if unset.
# Point tests at a DEV/DEMO Supabase only (the app needs a live DB to boot).
# Never commit real passwords; the demo password is the app's literal stub.
PLAYWRIGHT_BASE_URL="http://localhost:3000"
E2E_PASSWORD="password123"
E2E_SUPER_ADMIN_EMAIL="admin@stsn.edu.ph"
E2E_ADMIN_EMAIL="admin@cdsta.edu.ph"
E2E_REGISTRAR_EMAIL="registrar@stsn.edu.ph"
E2E_ACCOUNTING_EMAIL="accounting@stsn.edu.ph"
E2E_CASHIER_EMAIL="cashier@stsn.edu.ph"
E2E_TEACHER_EMAIL="teacher@stsn.edu.ph"
E2E_STUDENT_EMAIL="student@stsn.edu.ph"
E2E_HR_EMAIL="hr@stsn.edu.ph"
E2E_GUIDANCE_EMAIL="guidance@stsn.edu.ph"
E2E_NURSE_EMAIL="nurse@stsn.edu.ph"
E2E_PAYROLL_EMAIL="payroll@stsn.edu.ph"
# Demo GUARDIAN account (Parent Portal). Set blank to skip Parent Portal tests.
E2E_PARENT_EMAIL="parent.demo@stsn.edu.ph"
