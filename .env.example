# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project credentials (anon key is safe to expose client-side).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ----------------------------------------------------------------------------
# Teacher→Employee MUTATION UAT (tests/e2e/teacher-employee-consolidation-mutation.spec.ts)
# ----------------------------------------------------------------------------
# The mutation UAT WRITES rows through the app UI, so it is fenced behind an
# opt-in flag AND a confirmed-safe target. Leave these UNSET for normal runs —
# the mutation spec then skips. NEVER point these at production.
#
# Required to run the mutation spec:
#   ALLOW_MUTATION_UAT="true"                 # explicit opt-in; anything else skips
#   MUTATION_UAT_TARGET="local"               # one of: local | demo | uat | test
#
# Optional — verification/cleanup client (falls back to VITE_SUPABASE_ANON_KEY):
#   SUPABASE_SERVICE_ROLE_KEY=""              # local env ONLY; never commit; enables reliable teardown
#
# Optional — bridged faculty account used to drive the write flows
# (defaults to E2E_TEACHER_EMAIL / teacher@stsn.edu.ph + password123):
#   PLAYWRIGHT_TEST_USER_EMAIL="teacher@stsn.edu.ph"
#   PLAYWRIGHT_TEST_USER_PASSWORD="password123"
